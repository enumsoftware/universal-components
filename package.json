{
  "name": "@enumsoftware/universal-components",
  "version": "0.1.2",
  "description": "Reusable Angular standalone UI components for Enum Software apps",
  "scripts": {
    "a11y": "node scripts/a11y.ts",
    "a11y:update": "node scripts/a11y.ts --update",
    "build": "ng build universal-components",
    "pack:dist": "npm run build ; npm pack",
    "prepare": "npm run build",
    "scripts:typecheck": "tsc -p scripts/tsconfig.json",
    "test": "ng test universal-components",
    "tokens:check": "node scripts/check-token-parity.ts",
    "utilities:build": "node scripts/build-utilities.ts",
    "workbench": "npm run workbench:registry && ng serve workbench",
    "workbench:build": "npm run workbench:registry && ng build workbench",
    "workbench:registry": "node scripts/build-showcase-registry.ts"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/enumsoftware/universal-components.git"
  },
  "bugs": {
    "url": "https://github.com/enumsoftware/universal-components/issues"
  },
  "homepage": "https://github.com/enumsoftware/universal-components#readme",
  "sideEffects": false,
  "files": [
    "dist/**",
    "themes/**/*.css",
    "README.md"
  ],
  "exports": {
    ".": {
      "types": "./dist/types/enumsoftware-universal-components.d.ts",
      "default": "./dist/fesm2022/enumsoftware-universal-components.mjs"
    },
    "./public-api": {
      "types": "./dist/types/enumsoftware-universal-components.d.ts",
      "default": "./dist/fesm2022/enumsoftware-universal-components.mjs"
    },
    "./themes/theme.css": "./themes/theme.css",
    "./themes/utilities.css": "./themes/utilities.css",
    "./themes/utilities/scale.css": "./themes/utilities/scale.css",
    "./themes/utilities/display.css": "./themes/utilities/display.css",
    "./themes/utilities/sizing.css": "./themes/utilities/sizing.css",
    "./themes/utilities/flex.css": "./themes/utilities/flex.css",
    "./themes/utilities/grid.css": "./themes/utilities/grid.css",
    "./themes/utilities/alignment.css": "./themes/utilities/alignment.css",
    "./themes/utilities/gap.css": "./themes/utilities/gap.css",
    "./themes/utilities/margin.css": "./themes/utilities/margin.css",
    "./themes/utilities/padding.css": "./themes/utilities/padding.css",
    "./themes/utilities/composites.css": "./themes/utilities/composites.css",
    "./themes/uc-light.css": "./themes/uc-light.css",
    "./themes/uc-dark.css": "./themes/uc-dark.css",
    "./package.json": "./package.json"
  },
  "module": "dist/fesm2022/enumsoftware-universal-components.mjs",
  "typings": "dist/types/enumsoftware-universal-components.d.ts",
  "type": "module",
  "peerDependencies": {
    "@angular/aria": "^22.0.0",
    "@angular/cdk": "^22.0.0",
    "@angular/common": "^22.0.0",
    "@angular/core": "^22.0.0",
    "@angular/forms": "^22.0.0",
    "@angular/platform-browser": "^22.0.0",
    "@angular/router": "^22.0.0",
    "rxjs": "^7.8.0"
  },
  "dependencies": {
    "@phosphor-icons/web": "^2.1.2",
    "d3": "^7.9.0",
    "flag-icons": "^7.5.0",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular/aria": "^22.0.0",
    "@angular/build": "^22.0.0",
    "@angular/cdk": "^22.0.0",
    "@angular/cli": "^22.0.0",
    "@angular/common": "^22.0.0",
    "@angular/compiler": "^22.0.0",
    "@angular/compiler-cli": "^22.0.0",
    "@angular/core": "^22.0.0",
    "@angular/forms": "^22.0.0",
    "@angular/platform-browser": "^22.0.0",
    "@angular/router": "^22.0.0",
    "@types/d3": "^7.4.3",
    "@types/node": "^24.0.0",
    "axe-core": "^4.12.1",
    "jsdom": "^30.0.1",
    "marked": "^18.0.11",
    "ng-packagr": "^22.0.0",
    "playwright": "^1.61.1",
    "rxjs": "^7.8.0",
    "typescript": "~6.0.0",
    "vite": "^8.1.0",
    "vitest": "^4.0.8",
    "zone.js": "^0.15.1"
  },
  "allowScripts": {
    "esbuild@0.27.7": true,
    "esbuild@0.28.1": true,
    "@parcel/watcher@2.5.6": true,
    "lmdb@3.5.4": true,
    "msgpackr-extract@3.0.4": true
  }
}
