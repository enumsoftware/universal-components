{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "types": [
      "node"
    ],
    "noImplicitAny": false,
    "strict": true
  },
  "include": [
    "./**/*.ts"
  ],
  "exclude": [
    "./**/*.spec.ts",
    "./node_modules/**",
    "./scripts/**",
    "./storybook-static/**",
    "./workbench/**",
    "./**/*.showcase.ts",
    "./**/examples/**"
  ]
}
