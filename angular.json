{
  "$schema": "./node_modules/@angular/cli/lib/config/schema.json",
  "version": 1,
  "projects": {
    "universal-components": {
      "projectType": "library",
      "root": "",
      "sourceRoot": ".",
      "architect": {
        "build": {
          "builder": "@angular/build:ng-packagr",
          "options": {
            "project": "ng-package.json",
            "tsConfig": "tsconfig.lib.json"
          }
        },
        "test": {
          "builder": "@angular/build:unit-test",
          "options": {
            "buildTarget": "universal-components:build",
            "tsConfig": "tsconfig.spec.json"
          }
        }
      }
    },
    "storybook": {
      "projectType": "application",
      "root": "",
      "sourceRoot": ".",
      "architect": {
        "storybook": {
          "builder": "@analogjs/storybook-angular:start-storybook",
          "options": {
            "configDir": ".storybook",
            "compodoc": false,
            "port": 6006,
            "experimentalZoneless": true
          }
        },
        "build-storybook": {
          "builder": "@analogjs/storybook-angular:build-storybook",
          "options": {
            "configDir": ".storybook",
            "compodoc": false,
            "outputDir": "storybook-static",
            "experimentalZoneless": true
          }
        }
      }
    },
    "workbench": {
      "projectType": "application",
      "root": "workbench",
      "sourceRoot": "workbench",
      "architect": {
        "build": {
          "builder": "@angular/build:application",
          "options": {
            "browser": "workbench/main.ts",
            "index": "workbench/index.html",
            "tsConfig": "tsconfig.workbench.json",
            "styles": [
              "workbench/styles.css"
            ],
            "outputPath": "dist-workbench",
            "outputHashing": "media",
            "allowedCommonJsDependencies": [
              "axe-core"
            ]
          },
          "configurations": {
            "production": {
              "optimization": true,
              "outputHashing": "all"
            },
            "development": {
              "optimization": false,
              "sourceMap": true
            }
          },
          "defaultConfiguration": "production"
        },
        "serve": {
          "builder": "@angular/build:dev-server",
          "options": {
            "buildTarget": "workbench:build:development"
          },
          "configurations": {
            "production": {
              "buildTarget": "workbench:build:production"
            }
          }
        }
      }
    }
  },
  "cli": {
    "analytics": false
  }
}
